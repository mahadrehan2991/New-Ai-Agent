# Server Port
PORT=8000

# Deepgram (used for real-time STT and Aura TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Liquid AI LFM Brain (Local VPS vLLM, Ollama, or Liquid AI API)
LFM_BASE_URL=http://localhost:8000/v1
LFM_API_KEY=EMPTY
LFM_MODEL=liquid-lfm-40b

# Optional Fallback Model (if VPS LFM is overloaded or unreachable)
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# Twilio Credentials (for hangup and phone call management)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Maximum conversation messages before sliding window truncation
MAX_HISTORY_MESSAGES=14

# n8n Webhook URLs for connecting Airtable, Google Calendar, or CRM
N8N_LOOKUP_URL=https://your-n8n.com/webhook/patient-lookup
N8N_AVAILABILITY_URL=https://your-n8n.com/webhook/check-availability
N8N_SAVE_URL=https://your-n8n.com/webhook/save-appointment
N8N_WEBHOOK_URL=
